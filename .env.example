# Konfigurasi Lingkungan Apache Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Konfigurasi Google Cloud Platform & Google BigQuery
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=olist_dw
BIGQUERY_LOCATION=asia-southeast2

# Kunci Keamanan Airflow 3.x (buat string acak 32 karakter)
AIRFLOW__API_AUTH__JWT_SECRET=your_32_character_jwt_secret_here_
AIRFLOW__API__SECRET_KEY=your_32_character_secret_key_here_
